# Clave secreta de la app. Se usa para derivar el token de sesión, de modo
# que reiniciar el contenedor no cierre la sesión de quien ya había entrado.
# docker-up.sh la genera automáticamente la primera vez; no hace falta
# rellenarla a mano. Si la cambias, todas las sesiones abiertas se invalidan.
SECRET_KEY=

# Puerto host:contenedor. docker-up.sh lo sobreescribe siempre con el
# valor de [server] port en config.ini, así que normalmente no hace
# falta tocar esta línea (solo se usa si lanzas `docker compose up`
# directamente sin pasar por docker-up.sh).
PORT=3000

# Usuario con el que corre el contenedor (sin root). docker-up.sh y
# docker-update.sh los rellenan solos: tu UID/GID (`id -u` / `id -g`) y el
# grupo dueño de /var/run/docker.sock (`stat -c %g /var/run/docker.sock`).
DM_UID=
DM_GID=
DOCKER_GID=

# El usuario y la contraseña de acceso NO se configuran aquí: se crean la
# primera vez que abres la web y se guardan hasheados en el volumen de datos.

# Avisos por Telegram (opcional). Lo normal es configurarlo desde la web
# (Ajustes › Avisos) y dejar estas dos vacías. Si las rellenas, mandan sobre
# la web y allí aparecen bloqueadas.
# Token del bot: créalo con @BotFather en Telegram (/newbot).
TELEGRAM_BOT_TOKEN=
# IDs de usuario autorizados, separados por comas. Solo ellos reciben los
# avisos y pueden usar los comandos; los mensajes de cualquier otro se
# descartan sin procesarlos ni contestar. Tu ID te lo da @userinfobot.
TELEGRAM_IDS_PERMITIDOS=
